<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.levelup.gamechanger-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/christopherburhans/Documents/projects/levelup/scripts/gamechanger/run_sync.sh</string>
    </array>

    <!-- Fire at 06:00 local time daily. run_sync.sh adds 0-30 min jitter. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- If the Mac was asleep at fire time, run as soon as it wakes. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/christopherburhans/Documents/projects/levelup/scripts/gamechanger/logs/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/christopherburhans/Documents/projects/levelup/scripts/gamechanger/logs/launchd.stderr.log</string>
</dict>
</plist>
