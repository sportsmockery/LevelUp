# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local state
.claude/

# ssh keys (never commit)
gitkey
gitkey.pub
*.pem
id_rsa*
id_ed25519*

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Python service
/python/venv
/python/data
/python/runs
/python/__pycache__
/python/broken_contacts/__pycache__
/python/dataset_contacts_detector/train
/python/dataset_contacts_detector/val
/python/dataset_contacts_classifier/train
/python/dataset_contacts_classifier/val
*.pt
*.pth

# source assets
/LevelUpLogos
/docs
*.rtf
*.docx

# mobile app build artifacts
/mobile/node_modules
/mobile/.expo
/mobile/.next
/mobile/ios/Pods
/mobile/ios/build
/mobile/android/.gradle
/mobile/android/app/build
qqq_history.json
